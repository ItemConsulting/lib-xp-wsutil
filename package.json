{
  "name": "@item-enonic-types/lib-wsutil",
  "sideEffects": false,
  "description": "Type definitions for lib-wsutil",
  "author": "Tom Arild Jakobsen <tajakobsen@gmail.com>",
  "version": "3.0.0",
  "license": "Apache-2.0",
  "types": "dist/lib/wsutil/index.d.ts",
  "files": [
    "dist",
    "client.d.ts",
    "global.d.ts",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-wsutil.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/global": "^8.1.1",
    "@enonic-types/lib-websocket": "^8.1.1",
    "@item-enonic-types/global": "^8.0.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@enonic-types/core": "*"
  },
  "bugs": {
    "url": "https://github.com/ItemConsulting/lib-xp-wsutil/issues"
  },
  "homepage": "https://github.com/ItemConsulting/lib-xp-wsutil#readme",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:client": "tsc --noEmit -p src/main/resources/assets/tsconfig.json",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs",
    "prepublishOnly": "tsc --project src/main/resources/tsconfig.json --declarationDir dist --emitDeclarationOnly true --declaration true && tsc --project src/main/resources/assets/tsconfig.json --declarationDir dist --emitDeclarationOnly true --declaration true",
    "postpublish": "rm -r ./dist",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/test/register.mjs --test src/test/*.test.mts",
    "cov": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/test/register.mjs --test --experimental-test-coverage src/test/*.test.mts",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "check:types:tests": "tsc --noEmit -p src/test/tsconfig.json"
  }
}
